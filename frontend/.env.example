# Canonical origin for the deployed site, used for canonical tags, og:url,
# og:image and sitemap.xml at build time.
#
# Leave it unset for local builds: the build then omits canonical tags,
# sitemap.xml and robots.txt entirely rather than pointing crawlers at a host
# that is not serving the site.
#
# On Vercel this is picked up automatically from VERCEL_PROJECT_PRODUCTION_URL,
# so you only need to set it yourself for other hosts or to override the domain.
SITE_URL=https://example.com
