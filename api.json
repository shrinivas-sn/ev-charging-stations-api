{
  "manifest_version": 1,
  "slug": "ev-charging-stations",
  "name": "India EV Charging Station Directory API",
  "one_liner": "Keyless REST API for India's public EV charging stations from the Bureau of Energy Efficiency list: radius search, per-gun power, connector and vehicle filters, with attribution.",
  "category": "Transportation",
  "repo": "https://github.com/shrinivas-sn/ev-charging-stations-api",
  "source": {
    "name": "Bureau of Energy Efficiency (BEE), Ministry of Power — EV Public Charging Stations Data till 26th October 2025 (PDF)",
    "url": null,
    "license": "No licence published by BEE; republished with attribution (owner decision 15/10/2026)."
  },
  "not_provided": [
    "real-time charger availability or occupancy",
    "charging prices, payment or booking",
    "opening hours (not in the BEE source)"
  ],
  "stack": {
    "runtime": "node>=20",
    "backend": "express",
    "frontend": "react+vite",
    "map": "maplibre-gl with OpenFreeMap vector tiles (keyless)",
    "dataset": {
      "status": "real",
      "source_pdf_url": "http://beeindia.gov.in/WriteReadData/RTF1984/EV_PCS_Data_29277.pdf",
      "snapshot_label": "till 26th October 2025",
      "stations": 29184,
      "chargers": 39640,
      "states_and_union_territories": 36,
      "charge_point_operators": 70
    }
  },
  "deploy": {
    "portal_url": "https://ev-charging-stations-api.vercel.app",
    "api_base_url": "https://ev-charging-stations-api.vercel.app",
    "health_path": "/health",
    "warmup_path": "/health"
  },
  "routes": [
    { "path": "/", "base": "portal", "kind": "page" },
    { "path": "/docs", "base": "portal", "kind": "page" },
    { "path": "/playground", "base": "portal", "kind": "page" },
    { "path": "/guides", "base": "portal", "kind": "page" },
    { "path": "/status", "base": "portal", "kind": "page" },
    { "path": "/v1", "base": "api", "kind": "api" },
    { "path": "/v1/stations", "base": "api", "kind": "api" },
    { "path": "/v1/stations/near", "base": "api", "kind": "api" },
    { "path": "/v1/stations/evs_ef45e67bd1", "base": "api", "kind": "api" },
    { "path": "/v1/states", "base": "api", "kind": "api" },
    { "path": "/v1/cities", "base": "api", "kind": "api" },
    { "path": "/v1/operators", "base": "api", "kind": "api" },
    { "path": "/v1/connectors", "base": "api", "kind": "api" },
    { "path": "/v1/meta", "base": "api", "kind": "api" },
    { "path": "/health", "base": "api", "kind": "api" }
  ],
  "submission": {
    "terms": [
      "EV",
      "Electric Vehicle",
      "charging stations",
      "chargers India",
      "charging connectors"
    ],
    "targets": [
      {
        "repo": "public-apis/public-apis",
        "pr": null
      }
    ]
  }
}
