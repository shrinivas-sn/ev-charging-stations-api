{
  "manifest_version": 1,
  "slug": "ev-charging-stations",
  "name": "India EV Charging Station Directory API",
  "one_liner": "Keyless REST API for Indian public electric vehicle charging stations, connector standards and power ratings, shipping with a generated sample dataset.",
  "category": "Transportation",
  "repo": "https://github.com/shrinivas-sn/ev-charging-stations-api",
  "source": {
    "name": "Generated sample dataset, not official government data. Intended source: Ministry of Power / Bureau of Energy Efficiency via Open Government Data (data.gov.in).",
    "url": "https://data.gov.in",
    "license": "The bundled dataset is generated and carries no upstream licence. On ingest, the intended licence is the Government Open Data License - India (GODL-India)."
  },
  "not_provided": [
    "official government station data (the bundled dataset is generated sample data)",
    "real-time live plug occupancy or availability telemetry",
    "charging payment, pricing or booking transactions"
  ],
  "stack": {
    "runtime": "node>=20",
    "backend": "express",
    "frontend": "react+vite",
    "map": "maplibre-gl with OpenFreeMap vector tiles (keyless)",
    "dataset": {
      "status": "generated-sample",
      "is_official": false,
      "generator": "backend/scripts/generate-data.js",
      "seed": 20261015,
      "snapshot_date": "2026-10-15",
      "stations": 28698,
      "states_and_union_territories": 36,
      "cities": 104,
      "charge_point_operators": 9,
      "note": "Deterministic output, so the dataset can be regenerated byte-for-byte. Replace wholesale by ingesting the intended source."
    }
  },
  "deploy": {
    "portal_url": "https://ev-charging-stations-api.vercel.app",
    "api_base_url": "https://ev-charging-stations-api.vercel.app",
    "health_path": "/health",
    "warmup_path": "/health"
  },
  "routes": [
    { "path": "/", "base": "portal", "kind": "page" },
    { "path": "/docs", "base": "portal", "kind": "page" },
    { "path": "/playground", "base": "portal", "kind": "page" },
    { "path": "/guides", "base": "portal", "kind": "page" },
    { "path": "/status", "base": "portal", "kind": "page" },
    { "path": "/v1", "base": "api", "kind": "api" },
    { "path": "/v1/stations", "base": "api", "kind": "api" },
    { "path": "/v1/stations/near", "base": "api", "kind": "api" },
    { "path": "/v1/stations/1", "base": "api", "kind": "api" },
    { "path": "/v1/states", "base": "api", "kind": "api" },
    { "path": "/v1/operators", "base": "api", "kind": "api" },
    { "path": "/v1/connectors", "base": "api", "kind": "api" },
    { "path": "/v1/meta", "base": "api", "kind": "api" },
    { "path": "/health", "base": "api", "kind": "api" }
  ],
  "submission": {
    "terms": [
      "EV",
      "Electric Vehicle",
      "charging stations",
      "chargers India",
      "charging connectors"
    ],
    "targets": [
      {
        "repo": "public-apis/public-apis",
        "pr": null
      }
    ]
  }
}
