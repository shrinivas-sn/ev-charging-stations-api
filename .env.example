PORT=3000
NODE_ENV=development

# Rate limiting. Applied per client address; both values are optional.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000

# Number of trusted reverse proxy hops in front of the app. Vercel terminates TLS
# at its edge and forwards X-Forwarded-For, so 1 is correct there. Setting this
# to 0 makes every caller share a single rate-limit bucket.
TRUST_PROXY_HOPS=1

# Dataset generation (backend/scripts/generate-data.js).
DATASET_SEED=20261015
DATASET_SNAPSHOT_DATE=2026-10-15
