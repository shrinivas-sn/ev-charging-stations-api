PORT=3000
NODE_ENV=development

# Optional rate-limit overrides. Defaults: 100 requests per 15 minutes per client address.
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# Trusted reverse-proxy hops in front of the app. Vercel overwrites X-Forwarded-For with the
# real client address, so 1 is correct there. When running `npm start` with no proxy in front,
# set 0, or callers can choose their own rate-limit bucket by sending X-Forwarded-For.
# TRUST_PROXY_HOPS=1
